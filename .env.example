# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://qqqrziqluolfidyelgvr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Spring
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Razorpay (keep the secret server-side; use the public key in the browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Supabase Auth (publishable key is safe for client-side use; never expose the secret key)
SUPABASE_URL=https://qqqrziqluolfidyelgvr.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret/service-role key. Never expose as NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://qqqrziqluolfidyelgvr.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER_URI=https://qqqrziqluolfidyelgvr.supabase.co/auth/v1

# Supabase Postgres connection. Get the pooler URL, username, and password from Supabase Dashboard > Connect.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SUPABASE_DB_USER=postgres.PROJECT_REF
SUPABASE_DB_PASSWORD=

# Optional local Postgres fallback
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudpay
DB_USER=cloudpay
DB_PASSWORD=cloudpay_secret

# Legacy local JWT settings are not used for Supabase access-token verification.
JWT_SECRET=replace-with-a-strong-random-value
